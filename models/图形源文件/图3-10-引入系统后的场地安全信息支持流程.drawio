    <mxCell id="TO-SF01" value="选择授权场地，提交新版本或修订草稿及正式来源信息" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#315b55;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#24384b;labelBackgroundColor=#fffdf9;" edge="1" parent="1" source="l0" target="l1">
