      <mxPoint x="990" y="675" as="targetPoint" />
     </mxGeometry>
    </mxCell>
    <mxCell id="TO-SF07a" value="向编制人发送发布或退回结果通知；通知失败不回滚审核决定" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#315b55;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#24384b;labelBackgroundColor=#fffdf9;" edge="1" parent="1" source="l1" target="l0">
