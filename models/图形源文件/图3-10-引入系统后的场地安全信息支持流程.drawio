    </mxCell>
    <mxCell id="TO-SF02" value="保存草稿并返回版本号；草稿仍仅管理人员可见" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#315b55;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#24384b;labelBackgroundColor=#fffdf9;" edge="1" parent="1" source="l1" target="l4">
