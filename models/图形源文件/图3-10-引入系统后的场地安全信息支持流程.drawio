      <mxPoint x="770" y="880" as="targetPoint" />
     </mxGeometry>
    </mxCell>
    <mxCell id="TO-SF08" value="根据退回意见复制形成新草稿并递增版本；保留原退回事实" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#315b55;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#24384b;labelBackgroundColor=#fffdf9;" edge="1" parent="1" source="l0" target="l1">
