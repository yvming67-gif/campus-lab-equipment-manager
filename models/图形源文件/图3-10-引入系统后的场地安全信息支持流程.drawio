    <mxCell id="TO-SF09a" value="重新校验版本仍有效且要求确认；记录用户、版本与时间并追加审计；重复确认返回原回执" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#315b55;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#24384b;labelBackgroundColor=#fffdf9;" edge="1" parent="1" source="l1" target="l4">
