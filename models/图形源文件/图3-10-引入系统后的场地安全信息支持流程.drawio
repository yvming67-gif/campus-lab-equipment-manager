      <mxPoint x="110" y="765" as="targetPoint" />
     </mxGeometry>
    </mxCell>
    <mxCell id="TO-SF07b" value="通知相关申请人阅读当前版本；原预约不自动取消" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#315b55;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#24384b;labelBackgroundColor=#fffdf9;" edge="1" parent="1" source="l1" target="l3">
     <mxGeometry relative="1" as="geometry">
