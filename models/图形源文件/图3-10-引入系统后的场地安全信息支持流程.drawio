     </mxGeometry>
    </mxCell>
    <mxCell id="TO-SF09" value="查看当前发布版本与核实状态；按版本阅读后提交确认（如要求）" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#315b55;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#24384b;labelBackgroundColor=#fffdf9;" edge="1" parent="1" source="l3" target="l1">
