      <mxPoint x="990" y="205" as="targetPoint" />
     </mxGeometry>
    </mxCell>
    <mxCell id="TO-SF02a" value="编制人明确请求提交该草稿复核" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#315b55;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#24384b;labelBackgroundColor=#fffdf9;" edge="1" parent="1" source="l0" target="l1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="110" y="265" as="sourcePoint" />
      <mxPoint x="330" y="265" as="targetPoint" />
     </mxGeometry>
    </mxCell>
    <mxCell id="TO-SF02b" value="重新校验授权、场地类型、必填字段与日期，追加待审核状态和审计事实" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#315b55;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#24384b;labelBackgroundColor=#fffdf9;" edge="1" parent="1" source="l1" target="l4">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="330" y="325" as="sourcePoint" />
      <mxPoint x="990" y="325" as="targetPoint" />
     </mxGeometry>
    </mxCell>
    <mxCell id="TO-SF03" value="仅向同范围且非创建者的管理员提供待审核项" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#315b55;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#24384b;labelBackgroundColor=#fffdf9;" edge="1" parent="1" source="l1" target="l2">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="330" y="385" as="sourcePoint" />
      <mxPoint x="550" y="385" as="targetPoint" />
     </mxGeometry>
    </mxCell>
    <mxCell id="TO-SF04" value="核对来源和适用范围后，提交通过或退回决定及意见；系统不验证来源真伪" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#315b55;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#24384b;labelBackgroundColor=#fffdf9;" edge="1" parent="1" source="l2" target="l1">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="550" y="455" as="sourcePoint" />
      <mxPoint x="330" y="455" as="targetPoint" />
     </mxGeometry>
    </mxCell>
    <mxCell id="TO-SF05" value="通过：追加审核凭据并发布新版本，保留旧版本与确认记录" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#315b55;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#24384b;labelBackgroundColor=#fffdf9;" edge="1" parent="1" source="l1" target="l4">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="330" y="545" as="sourcePoint" />
      <mxPoint x="990" y="545" as="targetPoint" />
     </mxGeometry>
    </mxCell>
    <mxCell id="TO-SF06" value="退回：记录具体意见，当前已发布版本不变" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#315b55;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#24384b;labelBackgroundColor=#fffdf9;" edge="1" parent="1" source="l1" target="l4">
     <mxGeometry relative="1" as="geometry">
      <mxPoint x="330" y="625" as="sourcePoint" />
      <mxPoint x="990" y="625" as="targetPoint" />
     </mxGeometry>
    </mxCell>
    <mxCell id="TO-SF07" value="保存退回状态、审核责任和意见；保留原历史" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#315b55;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#24384b;labelBackgroundColor=#fffdf9;" edge="1" parent="1" source="l1" target="l4">
     <mxGeometry relative="1" as="geometry">
