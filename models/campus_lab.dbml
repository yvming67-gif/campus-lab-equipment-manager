Table core_incident {
  id "bigint" [pk, not null, note: 'ID']
  code "varchar(40)" [not null, unique, note: 'code']
  resource_id "bigint" [not null, note: 'resource']
  reporter_id "bigint" [not null, note: 'reporter']
  reservation_id "bigint" [note: 'reservation']
  kind "varchar(20)" [not null, note: 'kind；枚举：[('DAMAGE', '损坏'), ('MISSING', '缺件'), ('FAULT', '运行或场地异常')]']
  description "text" [not null, note: 'description']
  blocks_service "boolean" [not null, note: '阻断服务']
  occurred_at "timestamp with time zone" [not null, note: 'occurred at']
  reported_at "timestamp with time zone" [not null, note: 'reported at']
  status "varchar(16)" [not null, note: 'status；枚举：[('PENDING', '待核实'), ('CONFIRMED', '已确认'), ('DISMISSED', '已排除'), ('RESOLVED', '已解决')]']
  confirmed_by_id "bigint" [note: 'confirmed by']
  conclusion "text" [not null, note: 'conclusion']
  resolved_at "timestamp with time zone" [note: 'resolved at']
  Note: '资源异常事实；约束及条件唯一项以迁移文件为准。'
}
Table core_evidence {
  id "bigint" [pk, not null, note: 'ID']
  incident_id "bigint" [not null, note: 'incident']
