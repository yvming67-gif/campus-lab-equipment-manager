Project campus_lab { database_type: 'PostgreSQL' Note: '设备与场地独立预约；完整业务约束见数据设计说明与迁移文件。' }
Table core_role {
  id "bigint" [pk, not null, note: 'ID']
  code "varchar(20)" [not null, unique, note: '角色代码']
  name "varchar(40)" [not null, note: '角色名称']
  Note: '业务角色；约束及条件唯一项以迁移文件为准。'
}
Table core_user {
  id "bigint" [pk, not null, note: 'ID']
  password "varchar(128)" [not null, note: '密码']
  last_login "timestamp with time zone" [note: '上次登录']
  is_superuser "boolean" [not null, note: '超级用户状态']
  username "varchar(150)" [not null, unique, note: '用户名']
  first_name "varchar(150)" [not null, note: '名字']
  last_name "varchar(150)" [not null, note: '姓氏']
  email "varchar(254)" [not null, note: '电子邮件地址']
  is_staff "boolean" [not null, note: '工作人员状态']
  is_active "boolean" [not null, note: '有效']
  date_joined "timestamp with time zone" [not null, note: '加入日期']
  school_no "varchar(32)" [not null, unique, note: '学校唯一编号']
  display_name "varchar(60)" [not null, note: '显示名']
  Note: '身份映射；约束及条件唯一项以迁移文件为准。'
}
Table core_userrole {
  id "bigint" [pk, not null, note: 'ID']
  user_id "bigint" [not null, note: 'user']
  role_id "bigint" [not null, note: 'role']
  granted_by_id "bigint" [note: 'granted by']
  granted_at "timestamp with time zone" [not null, note: 'granted at']
  Note: '用户角色关联；约束及条件唯一项以迁移文件为准。'
}
Table core_lab {
  id "bigint" [pk, not null, note: 'ID']
  code "varchar(32)" [not null, unique, note: '实验室编号']
  name "varchar(80)" [not null, note: '名称']
  location "varchar(120)" [not null, note: '地点']
  description "text" [not null, note: '说明']
  is_active "boolean" [not null, note: '开放服务']
  Note: '实验室；约束及条件唯一项以迁移文件为准。'
}
Table core_labgrant {
  id "bigint" [pk, not null, note: 'ID']
  user_id "bigint" [not null, note: 'user']
  lab_id "bigint" [not null, note: 'lab']
  granted_at "timestamp with time zone" [not null, note: 'granted at']
  Note: '实验室管理范围；约束及条件唯一项以迁移文件为准。'
}
Table core_qualificationtype {
  id "bigint" [pk, not null, note: 'ID']
  code "varchar(32)" [not null, unique, note: 'code']
  name "varchar(80)" [not null, note: 'name']
  Note: '培训资格类型；约束及条件唯一项以迁移文件为准。'
}
Table core_userqualification {
  id "bigint" [pk, not null, note: 'ID']
  user_id "bigint" [not null, note: 'user']
  qualification_id "bigint" [not null, note: 'qualification']
  issued_at "timestamp with time zone" [not null, note: 'issued at']
  expires_at "timestamp with time zone" [note: 'expires at']
  revoked "boolean" [not null, note: 'revoked']
  granted_by_id "bigint" [note: 'granted by']
  Note: '用户培训资格；约束及条件唯一项以迁移文件为准。'
}
Table core_resource {
  id "bigint" [pk, not null, note: 'ID']
  code "varchar(40)" [not null, unique, note: '唯一标签或场地编号']
  name "varchar(100)" [not null, note: '资源名称']
  kind "varchar(16)" [not null, note: '资源类型；枚举：[('EQUIPMENT', '设备'), ('ROOM', '场地')]']
  lab_id "bigint" [not null, note: 'lab']
  description "text" [not null, note: '资源说明']
  service_status "varchar(20)" [not null, note: '服务状态；枚举：[('NORMAL', '正常'), ('ISOLATED', '异常隔离'), ('MAINTENANCE', '维护中'), ('DISABLED', '停用'), ('SCRAPPED', '报废')]']
  manual_hold "varchar(16)" [not null, note: '人工服务限制；枚举：[('', '无'), ('DISABLED', '停用'), ('SCRAPPED', '报废')]']
  created_at "timestamp with time zone" [not null, note: 'created at']
  updated_at "timestamp with time zone" [not null, note: 'updated at']
  Note: '可预约资源；约束及条件唯一项以迁移文件为准。'
}
Table core_equipmentdetail {
  id "bigint" [pk, not null, note: 'ID']
  resource_id "bigint" [not null, unique, note: 'resource']
  category "varchar(60)" [not null, note: '设备类别']
  risk "varchar(20)" [not null, note: '受限级别；枚举：[('NORMAL', '普通'), ('HIGH_VALUE', '高价值'), ('HAZARDOUS', '危险')]']
  qualification_id "bigint" [note: 'qualification']
  physical_status "varchar(16)" [not null, note: '实物状态；枚举：[('IN_STOCK', '在库'), ('BORROWED', '借出中')]']
  portable "boolean" [not null, note: '可独立外借']
  access_room_id "bigint" [note: 'access room']
  handover_location "varchar(120)" [not null, note: '交接地点']
  Note: '设备属性；约束及条件唯一项以迁移文件为准。'
}
Table core_roomdetail {
  id "bigint" [pk, not null, note: 'ID']
  resource_id "bigint" [not null, unique, note: 'resource']
  capacity "integer" [not null, note: '容纳人数']
  safety_note "text" [not null, note: '安全说明']
  Note: '场地属性；约束及条件唯一项以迁移文件为准。'
}
Table core_accessory {
  id "bigint" [pk, not null, note: 'ID']
  resource_id "bigint" [not null, note: 'resource']
  code "varchar(32)" [not null, note: 'code']
  name "varchar(80)" [not null, note: 'name']
  quantity "integer" [not null, note: 'quantity']
  is_active "boolean" [not null, note: 'is active']
  Note: '设备配件档案；约束及条件唯一项以迁移文件为准。'
}
Table core_openingperiod {
  id "bigint" [pk, not null, note: 'ID']
  lab_id "bigint" [not null, note: 'lab']
  weekday "smallint" [not null, note: '星期1至7']
  starts_at "time" [not null, note: '开放时间']
  ends_at "time" [not null, note: '关闭时间']
  valid_from "date" [not null, note: 'valid from']
  valid_to "date" [note: 'valid to']
  Note: '日间开放时段；约束及条件唯一项以迁移文件为准。'
}
Table core_policy {
  id "bigint" [pk, not null, note: 'ID']
  version "integer" [not null, note: 'version']
  window_days "integer" [not null, note: 'window days']
  slot_minutes "integer" [not null, note: 'slot minutes']
  max_hours "integer" [not null, note: 'max hours']
  equipment_quota "integer" [not null, note: 'equipment quota']
  room_quota "integer" [not null, note: 'room quota']
  simultaneous_equipment "integer" [not null, note: 'simultaneous equipment']
  grace_minutes "integer" [not null, note: 'grace minutes']
  mock_delivery_failure "boolean" [not null, note: 'mock delivery failure']
  updated_at "timestamp with time zone" [not null, note: 'updated at']
  Note: '当前业务参数；约束及条件唯一项以迁移文件为准。'
}
Table core_policyrevision {
  id "bigint" [pk, not null, note: 'ID']
  policy_id "bigint" [not null, note: 'policy']
  version "integer" [not null, note: 'version']
  data "jsonb" [not null, note: 'data']
  reason "text" [not null, note: 'reason']
  actor_id "bigint" [note: 'actor']
  created_at "timestamp with time zone" [not null, note: 'created at']
  Note: '参数历史版本；约束及条件唯一项以迁移文件为准。'
}
Table core_reservation {
  id "bigint" [pk, not null, note: 'ID']
  code "varchar(40)" [not null, unique, note: 'code']
  applicant_id "bigint" [not null, note: 'applicant']
  resource_id "bigint" [not null, note: 'resource']
  starts_at "timestamp with time zone" [not null, note: 'starts at']
  ends_at "timestamp with time zone" [not null, note: 'ends at']
  purpose "text" [not null, note: 'purpose']
  participants "integer" [not null, note: 'participants']
  status "varchar(16)" [not null, note: 'status；枚举：[('PENDING', '待审核'), ('CONFIRMED', '已确认'), ('REJECTED', '已驳回'), ('CANCELLED', '已取消'), ('EXPIRED', '已失效'), ('IN_USE', '使用中'), ('COMPLETED', '已完成')]']
  approval_mode "varchar(10)" [not null, note: 'approval mode；枚举：[('AUTO', '自动确认'), ('MANUAL', '人工审核')]']
  request_key "uuid" [not null, note: 'request key']
  request_fingerprint "varchar(64)" [not null, note: 'request fingerprint']
  policy_snapshot "jsonb" [not null, note: 'policy snapshot']
  reason "text" [not null, note: 'reason']
  version "integer" [not null, note: 'version']
  review_required "boolean" [not null, note: '暂停交接待复核']
  review_reason "text" [not null, note: '待复核原因']
  arrived_at "timestamp with time zone" [note: '已核实到场时间']
  late_start_until "timestamp with time zone" [note: '协调后的最晚开始时间']
  created_at "timestamp with time zone" [not null, note: 'created at']
  Note: '资源预约；约束及条件唯一项以迁移文件为准。'
}
Table core_reviewnote {
  id "bigint" [pk, not null, note: 'ID']
  reservation_id "bigint" [not null, note: 'reservation']
  actor_id "bigint" [not null, note: 'actor']
  kind "varchar(20)" [not null, note: 'kind；枚举：[('REQUEST_INFO', '要求补充'), ('PROVIDE_INFO', '补充材料')]']
  content "text" [not null, note: 'content']
  evidence_ref "varchar(240)" [not null, note: 'evidence ref']
  created_at "timestamp with time zone" [not null, note: 'created at']
  Note: '审核补充记录；约束及条件唯一项以迁移文件为准。'
}
Table core_approvaldecision {
  id "bigint" [pk, not null, note: 'ID']
  reservation_id "bigint" [not null, unique, note: 'reservation']
