Table core_incidentresponse {
  id "bigint" [pk, not null, note: 'ID']
  incident_id "bigint" [not null, note: 'incident']
  actor_id "bigint" [not null, note: 'actor']
  kind "varchar(20)" [not null, note: 'kind；枚举：[('ACK', '确认知悉'), ('DISPUTE', '提出异议'), ('SUPPLEMENT', '追加事实'), ('REVIEW', '独立复核结论')]']
  content "text" [not null, note: 'content']
  created_at "timestamp with time zone" [not null, note: 'created at']
  Note: '异常确认与异议记录；约束及条件唯一项以迁移文件为准。'
}
Table core_jobheartbeat {
  id "bigint" [pk, not null, note: 'ID']
  name "varchar(40)" [not null, unique, note: 'name']
  last_success "timestamp with time zone" [note: 'last success']
  last_error_at "timestamp with time zone" [note: 'last error at']
  error_code "varchar(80)" [not null, note: 'error code']
  Note: '后台任务健康记录；约束及条件唯一项以迁移文件为准。'
}
