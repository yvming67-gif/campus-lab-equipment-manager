page { background: #f5f6f1; color: #273b3c; font-family: -apple-system, BlinkMacSystemFont, 'Microsoft YaHei', sans-serif; font-size: 28rpx; line-height: 1.6; }
view, text, button, input, textarea, picker, scroll-view { box-sizing: border-box; }
button { font-size: 28rpx; border-radius: 14rpx; line-height: 1.5; padding: 23rpx 25rpx; margin: 0; }
button::after { border: 0; }
button[disabled] { opacity: .48; }
input { min-height: 80rpx; width: 100%; font-size: 28rpx; color: #273b3c; }
textarea { width: 100%; min-height: 148rpx; font-size: 28rpx; line-height: 1.6; color: #273b3c; }
.screen { padding: 36rpx 32rpx 54rpx; }
.eyebrow { font-size: 19rpx; letter-spacing: 4rpx; color: #63817a; font-weight: 600; }
.page-title { font-size: 48rpx; line-height: 1.28; font-weight: 650; letter-spacing: -1rpx; margin: 10rpx 0 12rpx; }
.sub { color: #758481; font-size: 24rpx; }
.row { display: flex; align-items: center; justify-content: space-between; }
.align-start { align-items: flex-start; }
.gap { gap: 18rpx; }
.top-gap { margin-top: 26rpx; }
.card { background: #fff; border: 1rpx solid #dfe5de; border-radius: 18rpx; padding: 28rpx; margin-top: 24rpx; }
.hero { background: #234c47; color: #fff; border-radius: 22rpx; padding: 34rpx; margin-top: 28rpx; }
.hero .eyebrow { color: #a5c6b6; }
.hero-title { font-size: 39rpx; font-weight: 600; line-height: 1.35; margin: 16rpx 0; }
.hero-sub { font-size: 24rpx; color: #d2e0d8; line-height: 1.7; }
.hero-stats { display: flex; margin-top: 28rpx; border-top: 1rpx solid #50756a; padding-top: 24rpx; }
.hero-stat { width: 33.33%; }
.stat-number { font-size: 40rpx; line-height: 1.1; font-weight: 600; display: block; }
.stat-label { display: block; margin-top: 8rpx; font-size: 22rpx; color: #c1d5c9; }
.chip { display: inline-block; padding: 5rpx 15rpx; border-radius: 8rpx; font-size: 21rpx; line-height: 1.65; background: #f1f2ec; color: #687870; white-space: nowrap; }
.green { background: #e9f3e9; color: #467755; }
.amber { background: #f7efdd; color: #956d2f; }
.blue { background: #e7eff6; color: #49708b; }
.red { background: #f7ebe5; color: #a35d43; }
.muted { background: #eef0ec; color: #7d867e; }
.white-tag { color: #d4e0d5; border: 1rpx solid #6b8b7b; background: transparent; }
.section-label { color: #47695d; font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; margin: 33rpx 0 8rpx; }
.tabs { display: flex; background: #e8ece4; padding: 7rpx; border-radius: 13rpx; margin-top: 26rpx; }
.tab { flex: 1; text-align: center; padding: 14rpx 10rpx; color: #7b887f; font-size: 25rpx; border-radius: 9rpx; }
.tab.active { background: #fff; color: #2d6358; font-weight: 600; }
.search-box { display: flex; align-items: center; background: white; border: 1rpx solid #dfe5de; border-radius: 13rpx; padding-left: 23rpx; margin-top: 19rpx; }
.search-box input { flex: 1; min-width: 0; }
.search-button { padding: 17rpx 23rpx; font-size: 24rpx; background: #fff; color: #3c6b60; }
.filter { margin-top: 19rpx; background: #edf0e9; padding: 13rpx 20rpx; border-radius: 10rpx; font-size: 23rpx; color: #63796b; }
.resource-card { position: relative; padding-top: 29rpx; }
.card-kicker { font-size: 21rpx; color: #8b978d; letter-spacing: 1rpx; }
.card-title { font-size: 31rpx; font-weight: 600; line-height: 1.4; margin: 9rpx 0; }
.card-meta { font-size: 23rpx; color: #7a887d; margin-top: 9rpx; }
.card-footer { border-top: 1rpx solid #edf0e9; margin-top: 23rpx; padding-top: 20rpx; }
.action-link { color: #3d6b5a; font-weight: 600; font-size: 24rpx; }
.primary { background: #275c52; color: white; width: 100%; }
.secondary { background: #eef3ec; color: #386654; width: 100%; border: 1rpx solid #d5e1d4; }
.danger-button { background: #f7ece5; color: #a76044; width: 100%; }
.text-button { background: transparent; color: #476c5c; font-size: 24rpx; padding: 10rpx; }
.field { padding-top: 21rpx; margin-top: 14rpx; border-top: 1rpx solid #edf0e8; }
.field.first { border-top: 0; padding-top: 0; margin-top: 0; }
.field-label { font-size: 23rpx; color: #7c897e; margin-bottom: 9rpx; display: block; }
.field-value { font-size: 28rpx; color: #304b41; padding: 15rpx 0; }
.field-box { background: #f5f7f2; padding: 0 18rpx; border-radius: 9rpx; }
.field-box textarea { padding: 17rpx 0; }
.form-times { display: flex; gap: 22rpx; }
.form-times .field { flex: 1; }
.hint { word-break: break-all; color: #899285; font-size: 21rpx; line-height: 1.7; margin-top: 12rpx; }
.error { background: #f8ece7; color: #a15b43; border: 1rpx solid #ebd8cc; border-radius: 13rpx; margin-top: 21rpx; padding: 21rpx; font-size: 24rpx; white-space: pre-wrap; }
.notice { padding: 21rpx; border-radius: 12rpx; background: #ebf1e6; color: #5b7555; font-size: 23rpx; margin-top: 20rpx; }
.empty { padding: 55rpx 23rpx; text-align: center; color: #8d968c; font-size: 25rpx; }
.empty-title { color: #5e7766; font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.loading { color: #84927f; text-align: center; padding: 26rpx; font-size: 24rpx; }
.detail-title { font-size: 40rpx; line-height: 1.4; font-weight: 600; margin: 18rpx 0; }
.detail-code { font-size: 22rpx; color: #92a48e; letter-spacing: 2rpx; }
.detail-description { font-size: 26rpx; color: #768672; margin-top: 23rpx; }
.kv { display: flex; justify-content: space-between; gap: 32rpx; padding: 14rpx 0; font-size: 25rpx; border-bottom: 1rpx solid #edf1e9; }
.kv-key { color: #899581; flex-shrink: 0; }
.kv-value { color: #40593e; text-align: right; overflow-wrap: anywhere; }
.time-row { padding: 11rpx 0; font-size: 23rpx; color: #637b57; }
.status-title { font-size: 46rpx; margin: 17rpx 0; font-weight: 600; }
.timeline-item { border-left: 2rpx solid #d8e3d1; margin-left: 8rpx; padding-left: 26rpx; padding-bottom: 27rpx; }
.timeline-title { font-size: 27rpx; font-weight: 600; color: #486b3e; }
.timeline-time { color: #96a08c; font-size: 21rpx; margin-top: 4rpx; }
.timeline-reason { color: #78886d; font-size: 24rpx; margin-top: 10rpx; }
.status-scroll { white-space: nowrap; margin-top: 26rpx; width: 100%; }
.status-filter { display: inline-block; margin-right: 15rpx; padding: 12rpx 21rpx; font-size: 24rpx; border-radius: 10rpx; color: #8b957f; }
.status-filter.active { color: #35612f; background: #e7efdf; font-weight: 600; }
.message { padding-left: 23rpx; border-left: 5rpx solid #dae3d1; }
.message.unread { border-left-color: #5d8550; }
.message-text { font-size: 27rpx; color: #435b38; margin-top: 12rpx; line-height: 1.8; }
.message-meta { font-size: 21rpx; color: #99a28d; margin-top: 17rpx; }
.profile-initial { width: 92rpx; height: 92rpx; line-height: 92rpx; text-align: center; border-radius: 25rpx; color: #527546; background: #e6efdc; font-size: 34rpx; font-weight: 600; margin-right: 23rpx; flex-shrink: 0; }
.profile-heading { display: flex; align-items: center; justify-content: flex-start; }
.small-copy { font-size: 23rpx; color: #8b9780; line-height: 1.9; }
.login-screen { padding: 68rpx 42rpx 40rpx; }
.login-mark { height: 100rpx; width: 100rpx; line-height: 100rpx; text-align: center; border-radius: 25rpx; color: #d5e3cc; background: #294f35; font-size: 30rpx; font-weight: 650; margin-bottom: 46rpx; }
.login-title { font-size: 57rpx; line-height: 1.25; font-weight: 650; color: #263d2c; margin: 19rpx 0 23rpx; }
.login-foot { color: #98a18d; text-align: center; font-size: 20rpx; margin-top: 38rpx; }
