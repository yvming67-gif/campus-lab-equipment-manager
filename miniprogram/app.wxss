/* Progressive glass: opaque cards remain readable when blur is unavailable. */
page { background: #f1f4fb; background-image: radial-gradient(ellipse at 100% 0%, #dfebff 0%, transparent 55%), radial-gradient(ellipse at 0% 70%, #ebe6fa 0%, transparent 48%); }
.card,.compact-booking { background: #ffffff; border: 1rpx solid #ffffff; box-shadow: inset 0 2rpx 0 #ffffff, 0 8rpx 28rpx rgba(38,55,84,.045); }
.card,.compact-booking,.tab,.status-filter,button { transition: transform .16s ease, background-color .18s ease, box-shadow .18s ease; }
.hero { background: #e7efff; border-color: #ffffff; box-shadow: inset 0 2rpx 0 #ffffff,0 9rpx 28rpx rgba(38,55,84,.035); }
.tabs { border: 1rpx solid rgba(255,255,255,.8); }
.primary { background: linear-gradient(160deg,#1687f7,#0071e3 70%); box-shadow: inset 0 2rpx 0 rgba(255,255,255,.28),0 5rpx 13rpx rgba(0,113,227,.12); }
.control-pressed { transform: scale(.97); opacity: .83; }
.card-pressed { transform: scale(.985); background: #eef4ff; }
.tab-pressed { opacity: .65; }
@supports (backdrop-filter: blur(20px)) { .card,.compact-booking { background: rgba(255,255,255,.74); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); } .hero { background: rgba(222,235,255,.78); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); } .tabs { background: rgba(222,229,242,.65); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); } }
@media (prefers-reduced-motion: reduce) { .card,.compact-booking,.tab,.status-filter,button { transition: none; } .control-pressed,.card-pressed { transform: none; } }

page { min-height: 100vh; background-repeat: no-repeat; }
