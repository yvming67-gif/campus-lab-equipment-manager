<view class="screen {{reducedEffects ? 'reduced-effects' : ''}}">
  <view class="eyebrow">MY CAMPUS LAB</view><view class="page-title">我的实验室</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <button wx:if="{{error}}" class="text-button" bindtap="retry" disabled="{{loading}}">重新加载</button>
  <view class="hint" wx:if="{{updatedAt}}">更新于 {{updatedAt}} · 北京时间</view>
  <view class="notice top-gap" wx:if="{{stale}}">{{loading ? '正在更新，以下保留上次读取的信息。' : '信息尚未更新，请重新加载后核对额度和资格。'}}</view>
  <view wx:if="{{user && stats && policy}}">
    <view class="card profile-heading"><view class="profile-initial">{{user.can_book_room ? '教' : '学'}}</view><view><view class="card-title">{{user.display_name}}</view><view class="card-meta">{{roleLabel}}</view><text class="chip green top-gap">{{user.can_book_room ? '设备 + 场地预约' : '设备预约'}}</text></view></view>
    <view class="error" wx:if="{{overdue}}">你有逾期未结束的使用记录，请先联系管理员办理结束。</view>
    <view class="section-label">我的安排</view><view class="personal-stats">
      <button class="personal-stat" data-status="PENDING" bindtap="openBookings" hover-class="control-pressed"><text class="stat-number">{{stats.pending}}</text><text>待审核</text></button>
      <button class="personal-stat" data-status="CONFIRMED" bindtap="openBookings" hover-class="control-pressed"><text class="stat-number">{{stats.confirmed}}</text><text>已确认</text></button>
      <button class="personal-stat" data-status="IN_USE" bindtap="openBookings" hover-class="control-pressed"><text class="stat-number">{{stats.using}}</text><text>使用中</text></button>
    </view>
    <view class="section-label">预约额度</view><view class="card">
      <view wx:if="{{equipmentQuota}}"><view class="kv"><text class="kv-key">未来设备预约</text><text class="kv-value">{{equipmentQuota.used}} / {{equipmentQuota.limit}} 项</text></view><progress percent="{{equipmentQuota.percent}}" stroke-width="6" activeColor="#0071e3" backgroundColor="#edf2fa" aria-label="设备预约已用{{equipmentQuota.used}}项，上限{{equipmentQuota.limit}}项" /><view class="hint">还可提交 {{equipmentQuota.remaining}} 项设备预约</view></view>
      <view class="hint" wx:else>设备额度暂未读取，请重新加载。</view>
      <view wx:if="{{user.can_book_room}}" class="top-gap"><view wx:if="{{roomQuota}}"><view class="kv"><text class="kv-key">未来场地预约</text><text class="kv-value">{{roomQuota.used}} / {{roomQuota.limit}} 项</text></view><progress percent="{{roomQuota.percent}}" stroke-width="6" activeColor="#247659" backgroundColor="#edf2fa" aria-label="场地预约已用{{roomQuota.used}}项，上限{{roomQuota.limit}}项" /><view class="hint">还可提交 {{roomQuota.remaining}} 项场地预约</view></view><view class="hint" wx:else>场地额度暂未读取，请重新加载。</view></view>
      <view class="hint top-gap">待审核与已确认的未来申请共同计入额度，两类分别计数。此处为当前快照，提交时仍会检查资格、时段和额度。</view>
      <button class="secondary top-gap" bindtap="browse" hover-class="control-pressed">{{user.can_book_room ? '查找设备与教室' : '查找实验设备'}}</button>
    </view>
    <view class="section-label">我的培训资格</view><view class="card"><view wx:for="{{qualifications}}" wx:key="code" class="qualification-item"><view class="row"><text>{{item.name}}</text><text class="chip {{item.valid ? 'green' : 'red'}}">{{item.valid ? '当前有效' : '当前无效'}}</text></view><view class="hint">有效期：{{item.expiry_label}}</view></view><view wx:if="{{!qualifications.length}}" class="small-copy">暂无专项培训资格；普通设备仍可按预约规则申请。</view><view class="hint">提交与批准时会核对整个预约时段的资格。资格由授权人员维护。</view></view>
    <view class="section-label">界面偏好</view><view class="card plain-card"><view class="effects-setting"><text>简化透明与动态效果</text><switch checked="{{reducedEffects}}" bindchange="chooseEffects" color="#0071e3" aria-label="简化透明与动态效果" /></view><view class="hint">仅保存此设备的显示偏好，各页面重新进入时生效。</view></view>
    <view class="section-label">使用约定</view><view class="card"><view class="kv"><text class="kv-key">可预约范围</text><text class="kv-value">未来 {{policy.window_days}} 天</text></view><view class="kv"><text class="kv-key">时间单位</text><text class="kv-value">{{policy.slot_minutes}} 分钟</text></view><view class="kv"><text class="kv-key">单次最长</text><text class="kv-value">{{policy.max_hours}} 小时</text></view><view class="kv"><text class="kv-key">同时借设备</text><text class="kv-value">最多 {{policy.simultaneous_equipment}} 台或套</text></view></view>
    <view class="card"><view class="small-copy">当前为模拟业务环境，请勿在用途、补充说明或异常报告中填写个人敏感信息。审批、实物交接及维修处理由网页管理端完成。</view></view>
  </view>
  <button hover-class="control-pressed" class="secondary top-gap" bindtap="signout" loading="{{busy}}" disabled="{{busy}}">退出并切换账号</button><view class="loading" wx:if="{{loading}}">正在更新个人信息…</view>
</view>
