<view class="screen {{reducedEffects ? 'reduced-effects' : ''}}">
  <view class="eyebrow">CAMPUS LAB / EXPLORE</view><view class="page-title">{{user.can_book_room ? "安排课程实验" : "查找实验设备"}}</view><view class="sub">{{user.can_book_room ? "按教学人数和时段选择教室，也可单独预约设备。" : "按名称或时段查找设备，跟进预约和借用进度。"}}</view>
  <view class="hero photo-hero"><view class="photo-hero-content"><view class="row"><text class="eyebrow">MY RESERVATIONS</text><text class="chip white-tag">演示资源目录</text></view><view wx:if="{{user.can_book_room}}" class="teacher-room-actions"><button class="secondary" hover-class="control-pressed" bindtap="openRoomFinder">按容量选择教室</button></view><view class="hero-stats"><view hover-class="card-pressed" class="hero-stat" data-status="PENDING" bindtap="openBookings"><text class="stat-number">{{overviewReady ? stats.pending : '—'}}</text><text class="stat-label">待审核</text></view><view class="hero-stat" data-status="CONFIRMED" bindtap="openBookings"><text class="stat-number">{{overviewReady ? stats.confirmed : '—'}}</text><text class="stat-label">已确认</text></view><view class="hero-stat" data-status="IN_USE" bindtap="openBookings"><text class="stat-number">{{overviewReady ? stats.using : '—'}}</text><text class="stat-label">使用中</text></view></view></view></view><view class="real-photo-credit">暂无本项目实验室实拍图 · 名称、位置与容量为模拟数据</view>
  <view wx:if="{{overviewLoading}}" class="hint">正在更新个人概览，资源查询可先进行。</view>
  <view wx:if="{{overviewError}}" class="error">个人概览暂未更新：{{overviewError}}。{{overviewReady ? '预约数字和使用安排为上次成功结果。' : '暂不显示预约数字。'}}请下拉刷新重试。</view>
  <view class="error" wx:if="{{error}}">资源查询失败：{{error}}<button class="text-button" bindtap="retry" loading="{{loading}}" disabled="{{loading}}">重试</button></view><view wx:if="{{stale}}" class="notice">当前列表是上次成功查询结果，信息可能已变化；重试更新后再选择资源。</view><view class="notice" wx:if="{{overdue}}">你有逾期未结束的使用记录，办理结束后才能新增预约。</view>
  <view wx:if="{{upcoming.length}}" class="next-bookings"><view class="section-label">接下来要使用</view><view hover-class="card-pressed" class="compact-booking" wx:for="{{upcoming}}" wx:key="id" data-id="{{item.id}}" bindtap="openBooking"><view class="row"><text class="compact-name">{{item.resource_name}}</text><text class="chip {{item.tone}}">{{item.status_label}}</text></view><view class="card-meta">{{item.time_label}}</view><view class="hint">{{item.review_required ? '暂停交接，请先联系管理员复核' : (item.status === 'IN_USE' ? '请按时办理归还或离场' : '到场后由管理员核验交接')}}</view></view></view>
  <view class="tabs" id="resource-search"><view hover-class="tab-pressed" class="tab {{kind === 'EQUIPMENT' ? 'active' : ''}}" data-kind="EQUIPMENT" bindtap="chooseKind">设备借用</view><view hover-class="tab-pressed" class="tab {{kind === 'ROOM' ? 'active' : ''}}" data-kind="ROOM" bindtap="chooseKind">场地预约</view></view>
  <view class="search-box"><input value="{{form.q}}" placeholder="搜索资源名称或编号" data-field="q" bindinput="input" bindconfirm="search" confirm-type="search" /><button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" class="search-button" bindtap="search">搜索</button></view>
  <picker range="{{labs}}" range-key="name" value="{{labIndex}}" bindchange="chooseLab"><view class="filter">管理单元：{{labs[labIndex].name}}　⌄</view></picker>
  <view class="location-filter-note">校区/楼宇筛选只匹配已登记结构化位置的场地及关联固定设备。可移动设备显示交接地点，不纳入校区/楼宇筛选。</view>
  <view class="form-times location-filter"><picker range="{{campuses}}" range-key="name" value="{{campusIndex}}" bindchange="chooseCampus"><view class="filter">校区：{{campuses[campusIndex].name}}　⌄</view></picker><picker range="{{buildings}}" range-key="name" value="{{buildingIndex}}" bindchange="chooseBuilding"><view class="filter">楼宇：{{buildings[buildingIndex].name}}　⌄</view></picker></view>
  <button hover-class="control-pressed" class="text-button top-gap" bindtap="toggleFilters">{{advancedFilters ? '收起目录筛选' : '类别、容量与状态筛选'}}　⌄</button>
  <view wx:if="{{advancedFilters}}" class="card time-filter"><text class="field-label">场地类别或设备类别</text><input value="{{form.category}}" placeholder="例如：计算机实验教室" data-field="category" bindinput="input" /><text class="field-label top-gap">设施或配件</text><input value="{{form.facility}}" placeholder="例如：教学工作台" data-field="facility" bindinput="input" /><view class="form-times"><view><text class="field-label">最小容量（人）</text><input type="number" value="{{form.capacity_min}}" placeholder="不限制" data-field="capacity_min" bindinput="input" /></view><view><text class="field-label">最大容量（人）</text><input type="number" value="{{form.capacity_max}}" placeholder="不限制" data-field="capacity_max" bindinput="input" /></view></view><text class="field-label top-gap">服务状态</text><picker range="{{serviceStatuses}}" range-key="name" value="{{serviceStatusIndex}}" bindchange="chooseServiceStatus"><view class="field-value">{{serviceStatuses[serviceStatusIndex].name}}　⌄</view></picker><button hover-class="control-pressed" class="secondary top-gap" bindtap="search" loading="{{loading}}" disabled="{{loading}}">应用目录筛选</button><view class="hint">容量仅作用于场地；服务状态不代表目标时段有空，也不代表现场可交付。</view></view>
  <button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" class="text-button top-gap" bindtap="toggleTime">{{timeSearch ? '关闭时段查询' : '按目标时段查询'}}　⌄</button>
  <view wx:if="{{timeSearch}}" class="card time-filter"><text class="field-label">目标日期（北京时间）</text><picker mode="date" value="{{slot.date}}" start="{{minDate}}" end="{{maxDate}}" bindchange="chooseQueryDate"><view class="field-value">{{slot.date}}　⌄</view></picker><scroll-view scroll-x class="quick-date-scroll" enhanced><view class="quick-date-strip"><button wx:for="{{quickDates}}" wx:key="day" class="quick-date {{item.selected ? 'selected' : ''}}" data-day="{{item.day}}" bindtap="chooseQuickQueryDate" hover-class="control-pressed" aria-label="{{item.day}} {{item.weekday}}" aria-pressed="{{item.selected}}"><text class="quick-weekday">{{item.weekday}}</text><text class="quick-day">{{item.label}}</text></button></view></scroll-view><view class="form-times"><view><text class="field-label">开始</text><picker mode="time" value="{{slot.start}}" bindchange="chooseQueryStart"><view class="field-value">{{slot.start}}　⌄</view></picker></view><view><text class="field-label">结束</text><picker mode="time" value="{{slot.end}}" bindchange="chooseQueryEnd"><view class="field-value">{{slot.end}}　⌄</view></picker></view></view><button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" class="secondary" bindtap="search" loading="{{loading}}" disabled="{{loading}}">查询该时段</button><view class="hint">查询不锁定资源，个人资格与配额在提交时另行核验。</view></view>
  <view wx:if="{{queryReady}}" class="query-result-summary"><view class="card-title">已应用查询 · {{appliedKind}}</view><view class="hint">当前可见目录匹配 {{total}} 项{{loading ? ' · 正在更新…' : ''}}</view><view class="query-mini-chips"><button wx:for="{{appliedChips}}" wx:key="key" class="query-chip-btn" data-key="{{item.key}}" bindtap="clearQueryFilter" hover-class="control-pressed" aria-label="清除{{item.label}}筛选">{{item.label}}　×</button></view><view wx:if="{{stale}}" class="hint">以下为上次成功查询结果，尚未应用当前修改的筛选条件。</view></view>
  <view class="row top-gap"><text class="small-copy">{{appliedTime ? '结果时段：'+appliedTime : '当前按资源档案浏览，尚未指定时段'}}</text><button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" class="text-button" bindtap="resetSearch">重置</button></view>
  <view wx:if="{{kind === 'ROOM' && !user.can_book_room}}" class="notice">整间场地仅教师可预约，学生可查看场地信息。</view>
  <view class="row section-label"><text>资源目录</text><text>{{total}} 项</text></view>
  <view hover-class="card-pressed" class="card resource-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="openResource"><view class="row"><view class="resource-identity"><view class="resource-mark {{item.icon_class}}" aria-role="img" aria-label="{{item.icon_label}}">{{item.icon_mark}}</view><text class="card-kicker">{{item.code}}</text></view><text class="chip {{item.tone}}">服务 · {{item.service_label}}</text></view><view class="card-title">{{item.name}}</view><view wx:if="{{!item.can_reserve}}" class="availability-result unavailable">{{item.reservation_block_reason}}</view><view class="card-meta">{{item.category_label}}</view><view wx:if="{{item.kind === 'EQUIPMENT'}}" class="card-meta"><text class="chip {{item.risk_tone}}">风险级别 · {{item.risk_label}}</text></view><view wx:if="{{item.kind === 'ROOM' && item.facilities}}" class="card-meta">设施 · {{item.facilities}}</view><view class="card-meta" wx:if="{{item.kind === 'EQUIPMENT'}}">实物 · {{item.physical_label}}</view><view class="card-meta">{{item.location_label}}：{{item.location}} · {{item.lab.name}}</view><view wx:if="{{appliedTime}}" class="availability-result {{item.availability_tone}}">目标时段 · {{item.available_label}}</view><view wx:else class="hint">尚未选择目标时段，服务正常不代表一定可约。</view><view wx:if="{{item.reference_photo}}" class="mini-reference-photo"><image wx:if="{{!photoErrors[item.reference_photo.id]}}" src="{{item.reference_photo.src}}" mode="aspectFit" lazy-load binderror="photoError" data-photo="{{item.reference_photo.id}}" aria-role="img" aria-label="{{item.reference_photo.alt}}" alt="{{item.reference_photo.alt}}"/><view wx:else class="photo-unavailable">实景图片暂不可用</view><view class="hint">{{item.reference_photo.caption}}</view></view><view class="row card-footer"><text class="chip">确认 · {{item.mode_label}}</text><text class="action-link">查看与预约　↗</text></view></view>
  <view wx:if="{{loading}}" class="loading">正在更新资源…</view><view wx:if="{{!loading && !error && items.length === 0}}" class="empty"><view class="empty-title">暂无匹配资源</view>试试其他名称或实验室。</view>
  <button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" wx:if="{{hasMore}}" class="text-button top-gap" bindtap="more" disabled="{{loading}}">加载更多</button>
</view>
