<view class="screen">
  <view class="eyebrow">CAMPUS LAB / EXPLORE</view><view class="page-title">找到你的实验资源</view><view class="sub">{{user.display_name}}，从一段可用时间开始。</view>
  <view class="hero"><view class="row"><text class="eyebrow">MY RESERVATIONS</text><text class="chip white-tag">教学资源共享</text></view><view class="hero-title"><view>预约有进度，</view><view>每一次使用都有记录。</view></view><view class="hero-stats"><view class="hero-stat" data-status="PENDING" bindtap="openBookings"><text class="stat-number">{{overviewReady ? stats.pending : '—'}}</text><text class="stat-label">待审核</text></view><view class="hero-stat" data-status="CONFIRMED" bindtap="openBookings"><text class="stat-number">{{overviewReady ? stats.confirmed : '—'}}</text><text class="stat-label">已确认</text></view><view class="hero-stat" data-status="IN_USE" bindtap="openBookings"><text class="stat-number">{{overviewReady ? stats.using : '—'}}</text><text class="stat-label">使用中</text></view></view></view>
  <view wx:if="{{overviewLoading}}" class="hint">正在更新个人概览，资源查询可先进行。</view>
  <view wx:if="{{overviewError}}" class="error">个人概览暂未更新：{{overviewError}}。{{overviewReady ? '预约数字和使用安排为上次成功结果。' : '暂不显示预约数字。'}}请下拉刷新重试。</view>
  <view class="error" wx:if="{{error}}">{{error}}</view><view class="notice" wx:if="{{overdue}}">你有逾期未结束的使用记录，办理结束后才能新增预约。</view>
  <view wx:if="{{upcoming.length}}" class="next-bookings"><view class="section-label">接下来要使用</view><view class="compact-booking" wx:for="{{upcoming}}" wx:key="id" data-id="{{item.id}}" bindtap="openBooking"><view class="row"><text class="compact-name">{{item.resource_name}}</text><text class="chip {{item.tone}}">{{item.status_label}}</text></view><view class="card-meta">{{item.time_label}}</view><view class="hint">{{item.review_required ? '暂停交接，请先联系管理员复核' : (item.status === 'IN_USE' ? '请按时办理归还或离场' : '到场后由管理员核验交接')}}</view></view></view>
  <view class="tabs"><view class="tab {{kind === 'EQUIPMENT' ? 'active' : ''}}" data-kind="EQUIPMENT" bindtap="chooseKind">设备借用</view><view class="tab {{kind === 'ROOM' ? 'active' : ''}}" data-kind="ROOM" bindtap="chooseKind">场地预约</view></view>
  <view class="search-box"><input value="{{form.q}}" placeholder="搜索资源名称或编号" data-field="q" bindinput="input" bindconfirm="search" confirm-type="search" /><button class="search-button" bindtap="search">搜索</button></view>
  <picker range="{{labs}}" range-key="name" value="{{labIndex}}" bindchange="chooseLab"><view class="filter">{{labs[labIndex].name}}　⌄</view></picker>
  <button class="text-button top-gap" bindtap="toggleTime">{{timeSearch ? '关闭时段查询' : '按目标时段查询'}}　⌄</button>
  <view wx:if="{{timeSearch}}" class="card time-filter"><text class="field-label">目标日期（北京时间）</text><picker mode="date" value="{{slot.date}}" start="{{minDate}}" end="{{maxDate}}" bindchange="chooseQueryDate"><view class="field-value">{{slot.date}}　⌄</view></picker><view class="form-times"><view><text class="field-label">开始</text><picker mode="time" value="{{slot.start}}" bindchange="chooseQueryStart"><view class="field-value">{{slot.start}}　⌄</view></picker></view><view><text class="field-label">结束</text><picker mode="time" value="{{slot.end}}" bindchange="chooseQueryEnd"><view class="field-value">{{slot.end}}　⌄</view></picker></view></view><button class="secondary" bindtap="search" loading="{{loading}}" disabled="{{loading}}">查询该时段</button><view class="hint">查询不锁定资源，个人资格与配额在提交时另行核验。</view></view>
  <view class="row top-gap"><text class="small-copy">{{appliedTime ? '结果时段：'+appliedTime : '当前按资源档案浏览，尚未指定时段'}}</text><button class="text-button" bindtap="resetSearch">重置</button></view>
  <view wx:if="{{kind === 'ROOM' && !user.can_book_room}}" class="notice">整间场地仅教师可预约，学生可查看场地信息。</view>
  <view class="row section-label"><text>资源目录</text><text>{{total}} 项</text></view>
  <view class="card resource-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="openResource"><view class="row"><text class="card-kicker">{{item.code}}</text><text class="chip {{item.tone}}">{{item.service_label}}</text></view><view class="card-title">{{item.name}}</view><view class="card-meta">{{item.category_label}}</view><view class="card-meta">{{item.lab.location}} · {{item.lab.name}}</view><view wx:if="{{appliedTime}}" class="availability-result {{item.availability_tone}}">{{item.available_label}}</view><view class="row card-footer"><text class="chip">{{item.mode_label}}</text><text class="action-link">查看与预约　↗</text></view></view>
  <view wx:if="{{loading}}" class="loading">正在更新资源…</view><view wx:if="{{!loading && items.length === 0}}" class="empty"><view class="empty-title">暂无匹配资源</view>试试其他名称或实验室。</view>
  <button wx:if="{{hasMore}}" class="text-button top-gap" bindtap="more" disabled="{{loading}}">加载更多</button>
</view>
