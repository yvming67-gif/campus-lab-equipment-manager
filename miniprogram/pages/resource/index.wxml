<view class="screen {{reducedEffects ? 'reduced-effects' : ''}}">
  <view class="error" wx:if="{{error}}">{{error}}</view><view class="loading" wx:if="{{loading}}">正在查询资源…</view>
  <view wx:if="{{item}}">
    <view class="row"><text class="eyebrow">{{item.kind === 'ROOM' ? 'SPACE / BOOKING' : 'EQUIPMENT / BOOKING'}}</text><text class="chip {{item.tone}}">服务 · {{item.service_label}}</text></view><view class="resource-identity top-gap"><view class="resource-mark {{item.icon_class}}" aria-role="img" aria-label="{{item.icon_label}}">{{item.icon_mark}}</view><view class="detail-title">{{item.name}}</view></view><view class="detail-code">{{item.code}}</view><view class="detail-description">{{item.description}}</view>
    <view wx:if="{{item.reference_photo}}" class="mini-reference-photo detail-reference"><image wx:if="{{!photoErrors[item.reference_photo.id]}}" src="{{item.reference_photo.src}}" mode="aspectFit" lazy-load binderror="photoError" data-photo="{{item.reference_photo.id}}" aria-role="img" aria-label="{{item.reference_photo.alt}}" alt="{{item.reference_photo.alt}}"/><view wx:else class="photo-unavailable">实景图片暂不可用</view><view class="real-photo-credit"><text>{{item.reference_photo.caption}}</text><button class="text-button" data-photo="{{item.reference_photo.id}}" bindtap="copyPhotoSource">图片来源</button></view></view>
    <view class="card"><view class="kv"><text class="kv-key">所属实验室</text><text class="kv-value">{{item.lab.name}}</text></view><view class="kv"><text class="kv-key">位置</text><text class="kv-value">{{item.lab.location}}</text></view><view class="kv"><text class="kv-key">确认方式</text><text class="kv-value">{{item.mode_label}}</text></view><view class="kv" wx:if="{{item.kind === 'ROOM'}}"><text class="kv-key">容纳人数</text><text class="kv-value">最多 {{item.capacity}} 人</text></view><view class="kv" wx:if="{{item.kind === 'EQUIPMENT'}}"><text class="kv-key">培训要求</text><text class="kv-value">{{item.qualification}}</text></view><view class="kv" wx:if="{{item.kind === 'EQUIPMENT'}}"><text class="kv-key">实物状态</text><text class="kv-value">{{item.physical_label}}</text></view><view class="hint" wx:if="{{item.kind === 'ROOM'}}">场地与室内设备分别预约，场地预约不会占用设备。</view></view>
    <view class="section-label">选择预约时段</view><view class="card"><view class="field first"><text class="field-label">日期</text><picker mode="date" value="{{form.date}}" start="{{minDate}}" end="{{maxDate}}" bindchange="chooseDate"><view class="field-value">{{form.date}}　⌄</view></picker></view><scroll-view scroll-x class="quick-date-scroll" enhanced><view class="quick-date-strip"><button wx:for="{{quickDates}}" wx:key="day" class="quick-date {{item.selected ? 'selected' : ''}}" data-day="{{item.day}}" bindtap="chooseQuickDate" hover-class="control-pressed" aria-label="{{item.day}} {{item.weekday}}" aria-pressed="{{item.selected}}"><text class="quick-weekday">{{item.weekday}}</text><text class="quick-day">{{item.label}}</text></button></view></scroll-view><view class="form-times"><view class="field"><text class="field-label">开始时间</text><picker mode="time" value="{{form.start}}" bindchange="chooseStart"><view class="field-value">{{form.start}}　⌄</view></picker></view><view class="field"><text class="field-label">结束时间</text><picker mode="time" value="{{form.end}}" bindchange="chooseEnd"><view class="field-value">{{form.end}}　⌄</view></picker></view></view><view class="hint">未来{{item.policy.window_days}}天 · {{item.policy.slot_minutes}}分钟单位 · 单次最长{{item.policy.max_hours}}小时</view>
      <view class="slot-toolbar"><picker range="{{durations}}" range-key="label" value="{{durationIndex}}" bindchange="chooseDuration"><view class="field-value">候选时长 · {{durations[durationIndex].label}}　⌄</view></picker><button class="secondary" hover-class="control-pressed" loading="{{slotsBusy}}" disabled="{{slotsBusy || busy}}" bindtap="loadSlots">查看当天候选时段</button></view>
      <view wx:if="{{slotsError}}" class="error">{{slotsError}}</view>
      <view wx:if="{{slotOptions}}" class="slot-options"><view class="hint">检查时间：{{slotOptions.checked_label}} · 点击可选项带入起止时间。</view><view class="slot-grid"><button wx:for="{{slotOptions.items}}" wx:for-item="candidate" wx:key="starts_at" class="slot-option {{candidate.available ? 'slot-available' : 'slot-unavailable'}}" hover-class="control-pressed" data-index="{{index}}" bindtap="selectSlot" disabled="{{!candidate.available || busy}}"><text class="slot-time">{{candidate.label}}</text><text class="slot-note">{{candidate.available ? '可选择' : candidate.reason}}</text></button></view><view wx:if="{{!slotOptions.items.length}}" class="hint">该日期没有符合当前条件的候选时段，请调整日期或手动查询。</view><view class="hint">{{slotOptions.notice}} 候选结果为当前快照，不锁定资源。</view></view><button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" class="secondary top-gap" bindtap="checkAvailability" disabled="{{loading || busy}}">检查所选时段</button><view wx:if="{{availability}}" class="notice {{available ? '' : 'red'}}">{{availability}}</view><view class="hint">时段查询不锁定资源，提交或批准时会再次检查。</view></view>
    <view class="section-label">填写使用信息</view><view class="card"><view class="field first"><text class="field-label">使用目的</text><view class="field-box"><textarea value="{{form.purpose}}" data-field="purpose" bindinput="input" placeholder="例如：传感器课程实验与数据采集" maxlength="1000" /></view></view><view class="field" wx:if="{{item.kind === 'ROOM'}}"><text class="field-label">参与人数</text><view class="field-box"><input type="number" value="{{form.participants}}" data-field="participants" bindinput="input" maxlength="5" /></view></view></view>
    <view class="notice" wx:if="{{item.requires_approval}}">本资源需人工审核。提交后可在“预约”中查看进度；待审核申请不占用时段。</view><view class="notice" wx:if="{{!item.requires_approval}}">普通设备通过资格、时段与配额检查后自动确认。</view>
    <button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" class="primary top-gap" bindtap="submit" loading="{{busy}}" disabled="{{busy || !item.can_apply || item.service_status !== 'NORMAL'}}">{{item.can_apply ? (item.requires_approval ? '提交预约申请' : '确认预约') : '仅教师可预约场地'}}</button>
    <button class="text-button top-gap" hover-class="control-pressed" bindtap="reportIncident">报告此资源的异常</button><view class="section-label">已确认的占用时段</view>
    <view class="card">
      <picker mode="date" value="{{scheduleDay || form.date}}" bindchange="chooseScheduleDay"><view class="field-value">{{scheduleDay || '全部后续占用'}}　选择日期⌄</view></picker>
      <button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" wx:if="{{scheduleDay}}" class="text-button" bindtap="clearScheduleDay">显示全部后续占用</button>
      <view class="hint">共{{scheduleTotal}}项，已显示{{item.schedule.length}}项；使用中记录保留至实际结束。</view>
      <view class="time-row" wx:for="{{item.schedule}}" wx:for-item="slot" wx:key="starts_at">{{slot.time_label}} · {{slot.status_label}}</view>
      <view wx:if="{{scheduleError}}" class="error">{{scheduleError}}</view>
      <view wx:if="{{scheduleBusy}}" class="loading">正在读取占用时段…</view>
      <view wx:if="{{!loading && !error && !scheduleBusy && !scheduleError && !item.schedule.length}}" class="hint">所选范围暂无已确认占用。</view>
      <button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" wx:if="{{scheduleHasMore}}" class="secondary" bindtap="moreSchedule" disabled="{{scheduleBusy || loading}}">继续查看占用时段</button>
      <view class="hint">仅显示时段及状态，不公开他人的申请人或使用目的。</view>
    </view>
  </view>
</view>
