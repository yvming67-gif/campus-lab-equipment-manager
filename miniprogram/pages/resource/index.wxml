<view class="screen {{reducedEffects ? 'reduced-effects' : ''}}">
  <view class="error" wx:if="{{error}}">{{error}}</view><button wx:if="{{error}}" class="text-button" bindtap="retry" disabled="{{loading}}">重新加载资源信息</button><view class="notice" wx:if="{{stale}}">当前显示的是上次成功读取的信息，刷新成功前不能据此预约或确认安全版本。</view><view class="loading" wx:if="{{loading}}">正在查询资源…</view>
  <view wx:if="{{item}}">
    <view class="row"><text class="eyebrow">{{item.kind === 'ROOM' ? 'SPACE / BOOKING' : 'EQUIPMENT / BOOKING'}}</text><text class="chip {{item.tone}}">服务 · {{item.service_label}}</text></view><view class="resource-identity top-gap"><view class="resource-mark {{item.icon_class}}" aria-role="img" aria-label="{{item.icon_label}}">{{item.icon_mark}}</view><view class="detail-title">{{item.name}}</view></view><view class="detail-code">{{item.code}}</view><view class="detail-description">{{item.description}}</view>
    <view wx:if="{{item.reference_photo}}" class="mini-reference-photo detail-reference"><image wx:if="{{!photoErrors[item.reference_photo.id]}}" src="{{item.reference_photo.src}}" mode="aspectFit" lazy-load binderror="photoError" data-photo="{{item.reference_photo.id}}" aria-role="img" aria-label="{{item.reference_photo.alt}}" alt="{{item.reference_photo.alt}}"/><view wx:else class="photo-unavailable">实景图片暂不可用</view><view class="real-photo-credit"><text>{{item.reference_photo.caption}}</text><button class="text-button" data-photo="{{item.reference_photo.id}}" bindtap="copyPhotoSource">图片来源</button></view></view>
    <view class="card"><view class="kv"><text class="kv-key">所属实验室</text><text class="kv-value">{{item.lab.name}}</text></view><view class="kv"><text class="kv-key">位置</text><text class="kv-value">{{item.location || item.lab.location}}</text></view><view class="kv"><text class="kv-key">确认方式</text><text class="kv-value">{{item.mode_label}}</text></view><view class="kv" wx:if="{{item.kind === 'ROOM'}}"><text class="kv-key">场地类别</text><text class="kv-value">{{item.space_category || '待登记'}}</text></view><view class="kv" wx:if="{{item.kind === 'ROOM'}}"><text class="kv-key">容纳人数</text><text class="kv-value">最多 {{item.capacity}} 人</text></view><view class="kv" wx:if="{{item.kind === 'ROOM'}}"><text class="kv-key">设施</text><text class="kv-value">{{item.facilities || '设施信息待管理员登记'}}</text></view><view wx:if="{{item.kind === 'ROOM'}}" class="opening-list"><text class="kv-key">近期开放时段（北京时间）</text><view wx:for="{{item.opening_schedule}}" wx:key="date" class="opening-item"><text>{{item.date}} {{item.weekday}}</text><text>{{item.ranges.length ? item.ranges.join('、') : item.note}}</text><text class="muted">{{item.note}}</text></view><view class="hint">场地独立时段优先于管理单元默认时段；管理单元单日例外适用于全部场地。提交时后端再次核验。</view></view><view class="kv" wx:if="{{item.kind === 'EQUIPMENT'}}"><text class="kv-key">风险级别</text><text class="kv-value"><text class="chip {{item.risk_tone}}">{{item.risk_label}}</text></text></view><view class="kv" wx:if="{{item.kind === 'EQUIPMENT'}}"><text class="kv-key">培训要求</text><text class="kv-value">{{item.qualification}}</text></view><view class="kv" wx:if="{{item.kind === 'EQUIPMENT'}}"><text class="kv-key">实物状态</text><text class="kv-value">{{item.physical_label}}</text></view><view class="kv" wx:if="{{item.kind === 'EQUIPMENT'}}"><text class="kv-key">交接地点</text><text class="kv-value">{{item.handover_label}}</text></view><view wx:if="{{item.kind === 'EQUIPMENT'}}" class="equipment-accessories"><text class="kv-key">配件清单</text><view wx:if="{{item.accessories.length}}"><view class="kv" wx:for="{{item.accessories}}" wx:for-item="accessory" wx:key="code"><text class="kv-key">{{accessory.name}}</text><text class="kv-value">× {{accessory.quantity}}</text></view></view><view wx:else class="hint">{{item.accessories_empty_label}}</view></view><view class="hint" wx:if="{{item.kind === 'ROOM'}}">场地与室内设备分别预约，场地预约不会占用设备。</view></view>
    <view wx:if="{{item.kind === 'ROOM'}}" class="card safety-card"><view class="row"><text class="section-label">场地安全信息</text><text class="chip" wx:if="{{item.safety_procedure && item.safety_current}}">当前发布 · v{{item.safety_procedure.version}}</text><text class="chip" wx:elif="{{item.safety_procedure}}">过期或待复核</text><text class="chip" wx:else>待责任岗位确认</text></view><view wx:if="{{item.safety_procedure}}"><view wx:if="{{!item.safety_current}}" class="hint">此历史版本已不满足当前生效与复核条件，仅供追溯；安全信息待责任岗位重新核实。</view><view class="safety-field"><text class="kv-key">标题与风险类别</text><text>{{item.safety_procedure.title}} · {{item.safety_procedure.risk_categories}}</text></view><view class="safety-field"><text class="kv-key">适用对象与前置条件</text><text>{{item.safety_procedure.applicable_users}} · {{item.safety_procedure.prerequisites}}</text></view><view class="safety-field"><text class="kv-key">个人防护用品</text><text>{{item.safety_procedure.required_ppe}}</text></view><view class="safety-field"><text class="kv-key">使用前检查</text><text>{{item.safety_procedure.pre_use_checks}}</text></view><view class="safety-field"><text class="kv-key">注意事项与禁止事项</text><text>{{item.safety_procedure.operating_cautions}} · {{item.safety_procedure.prohibited_actions}}</text></view><view class="safety-field"><text class="kv-key">异常处置</text><text>{{item.safety_procedure.incident_route}}</text></view><view class="hint">批准来源及材料编号或链接：{{item.safety_procedure.source_title}} · {{item.safety_procedure.source_reference}} · 版本：{{item.safety_procedure.source_version}} · 生效：{{item.safety_procedure.effective_from || '未登记'}} · 复核期限：{{item.safety_procedure.review_due_date || '未登记'}}</view><view class="hint">阅读确认不代表完成培训、考核、准入或现场检查。</view><button wx:if="{{item.safety_current && item.safety_procedure.requires_acknowledgement && !item.safety_acknowledged}}" class="secondary" loading="{{safetyBusy}}" disabled="{{safetyBusy || stale || busy}}" bindtap="acknowledgeSafety">阅读并确认此版本</button><view wx:if="{{item.safety_current && item.safety_procedure.requires_acknowledgement && item.safety_acknowledged}}" class="hint">已记录你对本版本的阅读确认。</view></view><view wx:else class="hint">本演示没有经责任岗位核定的风险、操作步骤、防护用品或应急联系人，因此不填入虚构安全规程。当前演示规则不会仅因未发布规程而自动阻止申请或审批；这不是学校安全许可，真实使用前须由校方责任岗位决定是否暂停相关预约。</view></view>
    <view wx:if="{{!item.can_reserve}}" class="notice red">{{item.reservation_block_reason}}</view><view class="section-label">选择预约时段</view><view class="card"><view class="field first"><text class="field-label">日期</text><picker mode="date" value="{{form.date}}" start="{{minDate}}" end="{{maxDate}}" disabled="{{busy}}" bindchange="chooseDate"><view class="field-value">{{form.date}}　⌄</view></picker></view><scroll-view scroll-x class="quick-date-scroll" enhanced><view class="quick-date-strip"><button wx:for="{{quickDates}}" wx:key="day" class="quick-date {{item.selected ? 'selected' : ''}}" data-day="{{item.day}}" disabled="{{busy}}" bindtap="chooseQuickDate" hover-class="control-pressed" aria-label="{{item.day}} {{item.weekday}}" aria-pressed="{{item.selected}}"><text class="quick-weekday">{{item.weekday}}</text><text class="quick-day">{{item.label}}</text></button></view></scroll-view><view class="form-times"><view class="field"><text class="field-label">开始时间</text><picker mode="time" value="{{form.start}}" disabled="{{busy}}" bindchange="chooseStart"><view class="field-value">{{form.start}}　⌄</view></picker></view><view class="field"><text class="field-label">结束时间</text><picker mode="time" value="{{form.end}}" disabled="{{busy}}" bindchange="chooseEnd"><view class="field-value">{{form.end}}　⌄</view></picker></view></view><view class="hint">未来{{item.policy.window_days}}天 · {{item.policy.slot_minutes}}分钟单位 · 单次最长{{item.policy.max_hours}}小时</view>
      <view class="slot-toolbar"><picker range="{{durations}}" range-key="label" value="{{durationIndex}}" disabled="{{busy}}" bindchange="chooseDuration"><view class="field-value">候选时长 · {{durations[durationIndex].label}}　⌄</view></picker><button class="secondary" hover-class="control-pressed" loading="{{slotsBusy}}" disabled="{{slotsBusy || busy}}" bindtap="loadSlots">查看当天候选时段</button></view>
      <view wx:if="{{slotsError}}" class="error">{{slotsError}}</view>
      <view wx:if="{{slotOptions}}" class="slot-options"><view class="hint">检查时间：{{slotOptions.checked_label}} · 点击可选项带入起止时间。</view><view class="slot-grid"><button wx:for="{{slotOptions.items}}" wx:for-item="candidate" wx:key="starts_at" class="slot-option {{candidate.available ? 'slot-available' : 'slot-unavailable'}}" hover-class="control-pressed" data-index="{{index}}" bindtap="selectSlot" disabled="{{!candidate.available || busy}}"><text class="slot-time">{{candidate.label}}</text><text class="slot-note">{{candidate.available ? '可选择' : candidate.reason}}</text></button></view><view wx:if="{{!slotOptions.items.length}}" class="hint">该日期没有符合当前条件的候选时段，请调整日期或手动查询。</view><view class="hint">{{slotOptions.notice}} 候选结果为当前快照，不锁定资源。</view></view><button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" class="secondary top-gap" bindtap="checkAvailability" disabled="{{loading || busy}}">检查所选时段</button><view wx:if="{{availability}}" class="notice {{available ? '' : 'red'}}">{{availability}}</view><view class="hint">时段查询不锁定资源，提交或批准时会再次检查。</view></view>
    <view class="section-label">填写使用信息</view><view class="card"><view class="field first"><text class="field-label">使用目的</text><view class="field-box"><textarea value="{{form.purpose}}" data-field="purpose" disabled="{{busy}}" bindinput="input" placeholder="例如：传感器课程实验与数据采集" maxlength="1000" /></view></view><view class="field" wx:if="{{item.kind === 'ROOM'}}"><text class="field-label">参与人数</text><view class="field-box"><input type="number" value="{{form.participants}}" data-field="participants" disabled="{{busy}}" bindinput="input" maxlength="5" /></view></view></view>
    <view class="notice" wx:if="{{item.requires_approval}}">本资源需人工审核。提交后可在“预约”中查看进度；待审核申请不占用时段。</view><view class="notice" wx:if="{{!item.requires_approval}}">普通设备通过资格、时段与配额检查后自动确认。</view>
    <view class="card reservation-review"><view class="section-label">提交前核对</view><view class="kv"><text class="kv-key">资源</text><text class="kv-value">{{item.name}}</text></view><view class="kv"><text class="kv-key">时段</text><text class="kv-value">{{form.date}} {{form.start}}—{{form.end}}（北京时间）</text></view><view class="kv"><text class="kv-key">用途</text><text class="kv-value">{{form.purpose || '尚未填写'}}</text></view><view class="kv"><text class="kv-key">处理方式</text><text class="kv-value">{{item.requires_approval ? '提交后由管理员人工审核' : '规则通过后自动确认'}}</text></view></view>
    <button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" class="primary top-gap" bindtap="submit" loading="{{busy}}" disabled="{{busy || safetyBusy || (stale && !hasPendingDraft) || ((!item.can_apply || !item.can_reserve) && !hasPendingDraft)}}">{{hasPendingDraft ? '核对上次预约结果' : (!item.can_apply ? '仅教师可预约场地' : (!item.can_reserve ? '暂不可预约' : (item.requires_approval ? '提交预约申请' : '确认预约')))}}</button>
    <button class="text-button top-gap" hover-class="control-pressed" disabled="{{busy || safetyBusy}}" bindtap="reportIncident">报告此资源的异常</button><view class="section-label">已确认的占用时段</view>
    <view class="card">
      <picker mode="date" value="{{scheduleDay || form.date}}" bindchange="chooseScheduleDay"><view class="field-value">{{scheduleDay || '全部后续占用'}}　选择日期⌄</view></picker>
      <button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" wx:if="{{scheduleDay}}" class="text-button" bindtap="clearScheduleDay">显示全部后续占用</button>
      <view class="hint">共{{scheduleTotal}}项，已显示{{item.schedule.length}}项；使用中记录保留至实际结束。</view>
      <view class="time-row" wx:for="{{item.schedule}}" wx:for-item="slot" wx:key="starts_at">{{slot.time_label}} · {{slot.status_label}}</view>
      <view wx:if="{{scheduleError}}" class="error">{{scheduleError}}</view>
      <view wx:if="{{scheduleBusy}}" class="loading">正在读取占用时段…</view>
      <view wx:if="{{!loading && !error && !scheduleBusy && !scheduleError && !item.schedule.length}}" class="hint">所选范围暂无已确认占用。</view>
      <button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" wx:if="{{scheduleHasMore}}" class="secondary" bindtap="moreSchedule" disabled="{{scheduleBusy || loading}}">继续查看占用时段</button>
      <view class="hint">仅显示时段及状态，不公开他人的申请人或使用目的。</view>
    </view>
  </view>
</view>
