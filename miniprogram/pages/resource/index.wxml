<view class="screen">
  <view class="error" wx:if="{{error}}">{{error}}</view><view class="loading" wx:if="{{loading}}">正在查询资源…</view>
  <view wx:if="{{item}}">
    <view class="row"><text class="eyebrow">{{item.kind === 'ROOM' ? 'SPACE / BOOKING' : 'EQUIPMENT / BOOKING'}}</text><text class="chip {{item.tone}}">{{item.service_label}}</text></view><view class="detail-title">{{item.name}}</view><view class="detail-code">{{item.code}}</view><view class="detail-description">{{item.description}}</view>
    <view class="card"><view class="kv"><text class="kv-key">所属实验室</text><text class="kv-value">{{item.lab.name}}</text></view><view class="kv"><text class="kv-key">位置</text><text class="kv-value">{{item.lab.location}}</text></view><view class="kv"><text class="kv-key">确认方式</text><text class="kv-value">{{item.mode_label}}</text></view><view class="kv" wx:if="{{item.kind === 'ROOM'}}"><text class="kv-key">容纳人数</text><text class="kv-value">最多 {{item.capacity}} 人</text></view><view class="kv" wx:if="{{item.kind === 'EQUIPMENT'}}"><text class="kv-key">培训要求</text><text class="kv-value">{{item.qualification}}</text></view><view class="kv" wx:if="{{item.kind === 'EQUIPMENT'}}"><text class="kv-key">实物状态</text><text class="kv-value">{{item.physical_label}}</text></view><view class="hint" wx:if="{{item.kind === 'ROOM'}}">场地与室内设备分别预约，场地预约不会占用设备。</view></view>
    <view class="section-label">选择预约时段</view><view class="card"><view class="field first"><text class="field-label">日期</text><picker mode="date" value="{{form.date}}" start="{{minDate}}" end="{{maxDate}}" bindchange="chooseDate"><view class="field-value">{{form.date}}　⌄</view></picker></view><view class="form-times"><view class="field"><text class="field-label">开始时间</text><picker mode="time" value="{{form.start}}" bindchange="chooseStart"><view class="field-value">{{form.start}}　⌄</view></picker></view><view class="field"><text class="field-label">结束时间</text><picker mode="time" value="{{form.end}}" bindchange="chooseEnd"><view class="field-value">{{form.end}}　⌄</view></picker></view></view><view class="hint">未来{{item.policy.window_days}}天 · {{item.policy.slot_minutes}}分钟单位 · 单次最长{{item.policy.max_hours}}小时</view><button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" class="secondary top-gap" bindtap="checkAvailability" disabled="{{loading || busy}}">检查所选时段</button><view wx:if="{{availability}}" class="notice {{available ? '' : 'red'}}">{{availability}}</view><view class="hint">时段查询不锁定资源，提交或批准时会再次检查。</view></view>
    <view class="section-label">填写使用信息</view><view class="card"><view class="field first"><text class="field-label">使用目的</text><view class="field-box"><textarea value="{{form.purpose}}" data-field="purpose" bindinput="input" placeholder="例如：传感器课程实验与数据采集" maxlength="1000" /></view></view><view class="field" wx:if="{{item.kind === 'ROOM'}}"><text class="field-label">参与人数</text><view class="field-box"><input type="number" value="{{form.participants}}" data-field="participants" bindinput="input" maxlength="5" /></view></view></view>
    <view class="notice" wx:if="{{item.requires_approval}}">本资源需人工审核。提交后可在“预约”中查看进度；待审核申请不占用时段。</view><view class="notice" wx:if="{{!item.requires_approval}}">普通设备通过资格、时段与配额检查后自动确认。</view>
    <button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" class="primary top-gap" bindtap="submit" loading="{{busy}}" disabled="{{busy || !item.can_apply || item.service_status !== 'NORMAL'}}">{{item.can_apply ? (item.requires_approval ? '提交预约申请' : '确认预约') : '仅教师可预约场地'}}</button>
    <view class="section-label">已确认的占用时段</view>
    <view class="card">
      <picker mode="date" value="{{scheduleDay || form.date}}" bindchange="chooseScheduleDay"><view class="field-value">{{scheduleDay || '全部后续占用'}}　选择日期⌄</view></picker>
      <button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" wx:if="{{scheduleDay}}" class="text-button" bindtap="clearScheduleDay">显示全部后续占用</button>
      <view class="hint">共{{scheduleTotal}}项，已显示{{item.schedule.length}}项；使用中记录保留至实际结束。</view>
      <view class="time-row" wx:for="{{item.schedule}}" wx:for-item="slot" wx:key="starts_at">{{slot.time_label}} · {{slot.status_label}}</view>
      <view wx:if="{{scheduleError}}" class="error">{{scheduleError}}</view>
      <view wx:if="{{scheduleBusy}}" class="loading">正在读取占用时段…</view>
      <view wx:if="{{!loading && !error && !scheduleBusy && !scheduleError && !item.schedule.length}}" class="hint">所选范围暂无已确认占用。</view>
      <button hover-class="control-pressed" hover-start-time="20" hover-stay-time="80" wx:if="{{scheduleHasMore}}" class="secondary" bindtap="moreSchedule" disabled="{{scheduleBusy || loading}}">继续查看占用时段</button>
      <view class="hint">仅显示时段及状态，不公开他人的申请人或使用目的。</view>
    </view>
  </view>
</view>
