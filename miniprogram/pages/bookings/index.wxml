<view class="screen"><view class="eyebrow">MY RESERVATIONS</view><view class="page-title">每一项安排，都有进度</view><view class="sub">查看本人预约、审核结果和实际使用状态。</view><view class="search-box"><input value="{{form.q}}" placeholder="搜索预约编号或资源名称" data-field="q" bindinput="input" bindconfirm="search" /><button class="search-button" bindtap="search">搜索</button></view><scroll-view scroll-x class="status-scroll"><view class="status-filter {{statusIndex === index ? 'active' : ''}}" wx:for="{{statuses}}" wx:key="code" data-index="{{index}}" bindtap="chooseStatus">{{item.name}}</view></scroll-view><view class="error" wx:if="{{error}}">{{error}}</view><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="openBooking"><view class="row"><text class="card-kicker">{{item.kind_label}} · {{item.code}}</text><text class="chip {{item.tone}}">{{item.status_label}}</text></view><view class="card-title">{{item.resource_name}}</view><view class="card-meta">{{item.time_label}}</view><view class="card-meta">{{item.lab_name}}</view><view class="row card-footer"><text class="small-copy">{{item.approval_mode === 'AUTO' ? '普通设备自动确认' : '人工审核申请'}}</text><text class="action-link">查看进度　↗</text></view></view><view wx:if="{{loading}}" class="loading">正在更新预约…</view><view wx:if="{{!loading && items.length === 0}}" class="empty"><view class="empty-title">这里还没有预约</view>到资源目录选择设备或场地吧。</view><button wx:if="{{hasMore}}" class="text-button top-gap" bindtap="more" disabled="{{loading}}">加载更多</button></view>
